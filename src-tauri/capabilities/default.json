{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-execute",
    "notification:default",
    "os:default",
    "dialog:default",
    "store:default",
    {
      "identifier": "fs:default",
      "allow": [
        { "path": "$HOME/.openclaw/**", "permissions": ["read"] }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://localhost:*" },
        { "url": "https://127.0.0.1:*" }
      ]
    }
  ]
}
